{
  "name": "gohan-diary",
  "version": "1.0.0",
  "private": true,
  "description": "食事を記録して栄養バランスを採点する食事管理アプリ",
  "scripts": {
    "start": "npx --yes http-server -p 8080 .",
    "test": "node --test test/*.test.js",
    "build:web": "node scripts/build-web.js",
    "android:sync": "npm run build:web && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
